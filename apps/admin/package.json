{
  "name": "@atlitos/admin",
  "version": "0.1.0",
  "private": true,
  "description": "Atlitos admin back office. Refine.dev + Supabase data provider, Vite based. Auth gate, verification queue, users list, P1.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen-tokens": "tsx scripts/gen-tokens.ts",
    "build": "pnpm gen-tokens && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@atlitos/theme": "workspace:*",
    "@atlitos/types": "workspace:*",
    "@refinedev/core": "^5.0.12",
    "@refinedev/react-router": "^2.0.4",
    "@refinedev/supabase": "^6.0.2",
    "@supabase/supabase-js": "^2.110.2",
    "lucide-react": "^1.24.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@atlitos/config": "workspace:*",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^8.1.4"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "1.1.5"
  }
}
