{
  "name": "@atlitos/theme",
  "version": "0.1.0",
  "private": true,
  "description": "Atlitos design tokens: colors, typography, radii, spacing, elevation, motion. Pure TypeScript, zero react dependency.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./colors": {
      "types": "./src/colors.ts",
      "default": "./src/colors.ts"
    },
    "./typography": {
      "types": "./src/typography.ts",
      "default": "./src/typography.ts"
    },
    "./radii": {
      "types": "./src/radii.ts",
      "default": "./src/radii.ts"
    },
    "./spacing": {
      "types": "./src/spacing.ts",
      "default": "./src/spacing.ts"
    },
    "./elevation": {
      "types": "./src/elevation.ts",
      "default": "./src/elevation.ts"
    },
    "./motion": {
      "types": "./src/motion.ts",
      "default": "./src/motion.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
